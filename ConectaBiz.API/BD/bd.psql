-- ============================================================
-- TABLAS
-- ============================================================

-- ------------------------------------------------------------
-- Pais
-- ------------------------------------------------------------
CREATE TABLE conectabiz."Pais" (
    "Id"                  integer      NOT NULL DEFAULT nextval('conectabiz."Pais_Id_seq"'::regclass),
    "Codigo"              varchar(5)   NOT NULL,
    "Nombre"              varchar(100) NOT NULL,
    "CodigoPostal"        varchar(10),
    "Activo"              boolean      NOT NULL DEFAULT true,
    "FechaRegistro"       timestamp    NOT NULL DEFAULT now(),
    "FechaModificacion"   timestamp,
    "UsuarioRegistro"     varchar(50),
    "UsuarioModificacion" varchar(50),
    CONSTRAINT "Pais_pkey" PRIMARY KEY ("Id")
);

-- ------------------------------------------------------------
-- Parametro
-- ------------------------------------------------------------
CREATE TABLE conectabiz."Parametro" (
    "Id"                  integer      NOT NULL DEFAULT nextval('conectabiz."Parametro_Id_seq"'::regclass),
    "TipoParametro"       varchar(30)  NOT NULL,
    "Codigo"              varchar(20)  NOT NULL,
    "Nombre"              varchar(100) NOT NULL,
    "Descripcion"         varchar(200),
    "Color"               varchar(7),
    "Icono"               varchar(50),
    "Orden"               smallint     NOT NULL DEFAULT 0,
    "Activo"              boolean      NOT NULL DEFAULT true,
    "FechaRegistro"       timestamp    NOT NULL DEFAULT now(),
    "FechaModificacion"   timestamp,
    "UsuarioRegistro"     varchar(50),
    "UsuarioModificacion" varchar(50),
    "Valor1"              text,
    "Valor2"              varchar,
    "Valor3"              varchar,
    CONSTRAINT "Parametro_pkey" PRIMARY KEY ("Id"),
    CONSTRAINT "CK_Parametro_TipoParametro" CHECK (
        ("TipoParametro")::text = ANY (ARRAY[
            'Prioridad','TipoTicket','EstadoTicket','TipoActividad',
            'TipoDocumento','Seniority','NivelExperiencia','ModalidadLaboral',
            'TipoCargaMasiva','Subtipos','TipoReporte'
        ])
    )
);

COMMENT ON COLUMN conectabiz."Parametro"."Valor1" IS 'Código de Estado a los que puede pasar el estado actual - TipoParametro = EstadoTicket';
COMMENT ON COLUMN conectabiz."Parametro"."Valor2" IS 'Codigo de Rol de los que pueden modificar el estado actual - TipoParametro = EstadoTicket';

